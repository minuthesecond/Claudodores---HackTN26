[Unit]
Description=Unspoken voicebank and accounts (voicebank/server.py, :8003)
After=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/unspoken/voicebank
Environment=PORT=8003
Environment=VOICE_DEVICE=cpu
Environment=COQUI_TOS_AGREED=1
# Accounts and recordings live outside the code folder, so deploys never touch them
Environment=VOICEBANK_DATA=/home/ubuntu/unspoken-data/voicebank
ExecStart=/home/ubuntu/unspoken/voicebank/.venv/bin/python server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
