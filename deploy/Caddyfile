# Unspoken on one machine: the built site, plus the servers under /api, /voice and /voicebank.
# {$SITE} is the public hostname, e.g. 147-224-207-225.sslip.io; Caddy gets its certificate.
{$SITE} {
	encode zstd gzip

	# lip reader: HTTP and the /stream WebSocket
	handle_path /api/* {
		reverse_proxy localhost:8000
	}

	# voicebank: accounts, banked voices, speech in them (uploads up to 500 MB)
	handle_path /voicebank/* {
		reverse_proxy localhost:8003 {
			flush_interval -1
		}
	}

	# voice: stream audio as it's generated, don't buffer it
	handle_path /voice/* {
		reverse_proxy localhost:8001 {
			flush_interval -1
		}
	}

	# the site; /app and other routes fall back to index.html
	handle {
		root * /var/www/unspoken
		try_files {path} /index.html
		file_server
	}
}
