[Unit]
Description=Unspoken voice (voice/voice_server.py, XTTS-v2, :8001)
After=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/unspoken/voice
Environment=VOICE_DEVICE=cpu
Environment=COQUI_TOS_AGREED=1
ExecStart=/home/ubuntu/unspoken/voice/.venv/bin/python voice_server.py --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
